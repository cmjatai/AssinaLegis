<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="br.leg.go.jatai.assinalegis.DocumentViewerController"
      alignment="CENTER"
      stylesheets="@styles.css">

    <HBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="5" right="5" bottom="5" left="5"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="5">
            <Button fx:id="btnModeM1" text="SAPL" onAction="#onSwitchToM1"/>
            <Button fx:id="btnModeM2" text="LOCAL" onAction="#onSwitchToM2"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="5" fx:id="hBoxM1Controls" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>
                <Button text="Assinar Selecionados" onAction="#onSign"/>
                <Button fx:id="btnSubmeterM1" text="Submeter Assinados" onAction="#onSend"/>
                <HBox alignment="CENTER" spacing="5">
                    <Button fx:id="btnFirstPage" text="&lt;&lt;" onAction="#onFirstPage"/>
                    <Button fx:id="btnPrevPage" text="&lt;" onAction="#onPrevPage"/>
                    <Button fx:id="btnNextPage" text="&gt;" onAction="#onNextPage"/>
                    <Button fx:id="btnLastPage" text="&gt;&gt;" onAction="#onLastPage"/>
                </HBox>
                <HBox alignment="CENTER" spacing="5">
                    <Button fx:id="btnFitWidth" text="Ajustar à Largura" onAction="#onFitWidth"/>
                    <Button fx:id="btnZoomOut" text="-" onAction="#onZoomOut"/>
                    <Button fx:id="btnZoomIn" text="+" onAction="#onZoomIn"/>
                    <Button fx:id="btnFitHeight" text="Ajustar à Altura" onAction="#onFitHeight"/>
                </HBox>
            </HBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="5" fx:id="hBoxM2Controls" HBox.hgrow="ALWAYS" visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Arquivos Locais para Assinatura" HBox.hgrow="ALWAYS" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Button text="Carregar PDFs" onAction="#onLoadLocalFiles"/>
                <Button text="Limpar Lista" onAction="#onClearLocalList"/>
                <CheckBox fx:id="chkSelectAllM2" text="Selecionar Todos" onAction="#onSelectAll"/>
            </HBox>
            <HBox alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>
                <Button text="Assinar Todos Selecionados" onAction="#onSign"/>
                <Button text="Salvar Arquivos Assinados" onAction="#onSaveSignedFiles"/>
                <HBox alignment="CENTER" spacing="5">
                    <Button text="&lt;&lt;" onAction="#onFirstPage"/>
                    <Button text="&lt;" onAction="#onPrevPage"/>
                    <Button text="&gt;" onAction="#onNextPage"/>
                    <Button text="&gt;&gt;" onAction="#onLastPage"/>
                </HBox>
                <HBox alignment="CENTER" spacing="5">
                    <Button text="Ajustar à Largura" onAction="#onFitWidth"/>
                    <Button text="-" onAction="#onZoomOut"/>
                    <Button text="+" onAction="#onZoomIn"/>
                    <Button text="Ajustar à Altura" onAction="#onFitHeight"/>
                </HBox>
            </HBox>
        </HBox>
    </HBox>

    <HBox fx:id="vBoxListProps" spacing="0" alignment="CENTER" VBox.vgrow="ALWAYS">

        <TabPane fx:id="tabPaneM1" prefWidth="410" minWidth="410" maxWidth="410"
                 tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

            <Tab fx:id="tabMinhas" text="Minhas Proposições">
                <VBox VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 4 6 4 6; -fx-background-color: #f0f0f0;">
                        <CheckBox fx:id="chkSelectAll" text="Sel. Todos" onAction="#onSelectAll"/>
                        <Button text="Atualizar" onAction="#onRefreshDocuments"/>
                    </HBox>
                    <ListView fx:id="documentListView" VBox.vgrow="ALWAYS" prefHeight="2000"/>
                </VBox>
            </Tab>

            <Tab fx:id="tabSolicitacoes" text="Solicitações">
                <VBox VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 4 6 4 6; -fx-background-color: #f0f0f0;">
                        <Button text="Atualizar" onAction="#onRefreshSolicitacoes"/>
                    </HBox>
                    <ListView fx:id="documentListViewSolicitacoes" VBox.vgrow="ALWAYS" prefHeight="1800"/>
                    <HBox fx:id="hBoxLockStatus" spacing="8" alignment="CENTER_LEFT"
                          visible="false" managed="false"
                          style="-fx-background-color: #fffbe6; -fx-border-color: #e6a817; -fx-border-width: 0 0 0 4; -fx-padding: 6 8 6 8;">
                        <Label fx:id="lblLockItem" text="" HBox.hgrow="ALWAYS"
                               style="-fx-font-size: 11px; -fx-font-weight: bold;" maxWidth="Infinity"/>
                        <ProgressBar fx:id="pbLockCountdown" prefWidth="70" prefHeight="12"/>
                        <Label fx:id="lblLockTempo" text="" style="-fx-font-size: 11px;"/>
                        <Button fx:id="btnLiberarLock" text="Liberar" onAction="#onLiberarLock"/>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>

        <ScrollPane fx:id="scrollPane" HBox.hgrow="ALWAYS" maxWidth="Infinity" fitToWidth="true" fitToHeight="true" pannable="true" style="-fx-background-color: #aaaaaa;">
            <padding>
                <Insets top="5" right="5" bottom="5" left="5"/>
            </padding>
            <StackPane fx:id="contentHolder" style="-fx-background-color: #aaaaaa;"/>
        </ScrollPane>
    </HBox>

</VBox>
